# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_token_here

# Comma-separated Telegram user IDs that may use the bot (leave empty to allow all)
ALLOWED_USER_IDS=123456789,987654321

# AnkiWeb credentials for automatic sync (optional — leave empty to skip auto-login)
ANKIWEB_EMAIL=you@example.com
ANKIWEB_PASSWORD=your_ankiweb_password

# Default deck for imported cards
DEFAULT_DECK=Imported

# Anthropic API key for /analyse (optional — leave empty to disable the command)
ANTHROPIC_API_KEY=
